---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BtcWatermark from '../components/BtcWatermark.astro';
import CardEffects from '../components/CardEffects.astro';
import JsonLd from '../components/JsonLd.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  keywords?: string[];
}

const {
  title = 'Bitcoin Sin Ruido — Bitcoin desde el protocolo, sin ruido de precio',
  description = 'Bitcoin explicado desde el protocolo: Lightning, Taproot, BitVM, covenants, escalabilidad y futuro. Sin hype ni predicciones de precio. Referencia técnica en español.',
  image = '/og-default.svg',
  canonical,
  noindex = false,
  keywords = [],
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://bitcoinsinruidos.com';
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site ?? 'https://bitcoinsinruidos.com').toString();
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'Bitcoin Sin Ruido',
  alternateName: 'BSR',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/favicon.svg`,
    width: 512,
    height: 512,
  },
  description:
    'Referencia técnica en español sobre Bitcoin: protocolo, Lightning, BitVM, Taproot, covenants y resistencia cuántica. Sin predicciones de precio.',
  sameAs: ['https://x.com/BitcoinSinRuido', 'https://paragraph.com/@bitcoinsinruido'],
  knowsAbout: [
    'Bitcoin',
    'Lightning Network',
    'BitVM',
    'Taproot',
    'Covenants',
    'Proof of Work',
    'UTXO',
    'Bitcoin scalability',
    'Post-quantum cryptography',
  ],
  foundingDate: '2025',
  areaServed: ['ES', 'MX', 'AR', 'CO', 'CL', 'PE', 'UY', 'VE', 'US'],
  employee: { '@id': `${siteUrl}/sobre#editor` },
  publishingPrinciples: `${siteUrl}/metodologia`,
  ethicsPolicy: `${siteUrl}/metodologia`,
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: 'Bitcoin Sin Ruido',
  inLanguage: 'es',
  description:
    'Bitcoin explicado desde el protocolo. Lightning, BitVM, Taproot, escalabilidad y futuro. Sin ruido de precio.',
  publisher: { '@id': `${siteUrl}/#organization` },
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/articulos?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

// Home renders the blockchain background; every other page renders the
// floating ₿ watermark instead.
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="light dark" />

    <!-- Theme bootstrap: applied before paint to avoid flash of wrong theme.
         Default for new visitors is light; we ignore prefers-color-scheme so
         the brand-orange light theme is what loads on the domain. If the user
         explicitly toggled dark we respect that via localStorage. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark') document.documentElement.classList.add('dark');
        } catch (_) {
          /* fallback to default (light) theme */
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {!noindex && <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />}
    <meta name="author" content="Bitcoin Sin Ruido" />
    <meta http-equiv="content-language" content="es" />
    <link rel="alternate" hreflang="es" href={canonicalURL} />
    <link rel="alternate" hreflang="es-ES" href={canonicalURL} />
    <link rel="alternate" hreflang="es-MX" href={canonicalURL} />
    <link rel="alternate" hreflang="es-AR" href={canonicalURL} />
    <link rel="alternate" hreflang="es-CO" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Bitcoin Sin Ruido" href="/rss.xml" />

    <!-- Preconnect to exchange WS endpoints -->
    <link rel="preconnect" href="https://stream.binance.com" />
    <link rel="preconnect" href="https://ws-feed.exchange.coinbase.com" />
    <link rel="preconnect" href="https://ws.kraken.com" />
    <link rel="preconnect" href="https://ws.bitstamp.net" />
    <link rel="preconnect" href="https://api.bitso.com" />

    <!-- Fonts: variable Inter + JetBrains Mono via Google Fonts (no FOIT) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bitcoin Sin Ruido" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <JsonLd data={organizationLd} />
    <JsonLd data={websiteLd} />

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-btc focus:text-bg focus:px-3 focus:py-2 focus:rounded"
    >
      Saltar al contenido
    </a>
    {!isHome && <BtcWatermark />}
    <CardEffects />
    <Nav />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
