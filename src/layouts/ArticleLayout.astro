---
import BaseLayout from './BaseLayout.astro';
import ArticleMeta from '../components/ArticleMeta.astro';

export interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags?: string[];
  capa: string;
  cover?: string;
  author?: string;
  readingTime?: number;
}

const { title, description, publishedAt, updatedAt, tags = [], capa, cover, author = 'Bitcoin Sin Ruido', readingTime } = Astro.props;
---

<BaseLayout title={`${title} · Bitcoin Sin Ruido`} description={description} image={cover}>
  <article class="container-reading py-12 sm:py-16 animate-fade-in">
    <header class="mb-10">
      <div class="flex flex-wrap gap-2 mb-4">
        <span class="chip-btc">Capa · {capa}</span>
        {tags.map((tag) => <span class="chip">#{tag}</span>)}
      </div>
      <h1 class="text-h1 font-semibold tracking-tight text-balance text-ink">{title}</h1>
      <p class="mt-4 text-lg text-ink-muted text-pretty">{description}</p>
      <ArticleMeta publishedAt={publishedAt} updatedAt={updatedAt} author={author} readingTime={readingTime} />
    </header>

    <div class="prose-bsr">
      <slot />
    </div>

    <footer class="mt-16 pt-8 border-t border-line">
      <a href="/articulos" class="btn">← Todos los artículos</a>
    </footer>
  </article>
</BaseLayout>
