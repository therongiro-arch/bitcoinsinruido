---
import BaseLayout from './BaseLayout.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import ShareButtons from '../components/ShareButtons.astro';
import JsonLd from '../components/JsonLd.astro';

export interface FaqItem {
  question: string;
  answer: string;
}

export interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags?: string[];
  capa: string;
  cover?: string;
  author?: string;
  readingTime?: number;
  slug: string;
  keywords?: string[];
  faqs?: FaqItem[];
  related?: string[];
  canonical?: string;
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  tags = [],
  capa,
  cover,
  author = 'Bitcoin Sin Ruido',
  readingTime,
  slug,
  keywords = [],
  faqs = [],
  related = [],
  canonical,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://bitcoinsinruidos.com';
// Cloudflare sirve con barra final (trailingSlash: 'always'). El JSON-LD debe
// usar la misma URL 200 que el canonical para que los motores (y los LLMs)
// atribuyan la entidad sin ambigüedad. El canonical externo (variantes) se
// respeta tal cual.
const url = canonical ?? `${siteUrl}/articulos/${slug}/`;
// Cada artículo tiene una imagen OG generada en build a /og/{slug}.png.
// Si el frontmatter trae cover propio (raro), gana esa. ogImagePath es
// la ruta relativa (la pasamos a BaseLayout, que la convierte a absoluta).
// ogImage es la URL absoluta usada para el JSON-LD.
const ogImagePath = cover ?? `/og/${slug}.png`;
const ogImage = ogImagePath.startsWith('http') ? ogImagePath : `${siteUrl}${ogImagePath}`;

const seoTitle = `${title} | Bitcoin Sin Ruido`;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${url}#article`,
  headline: title,
  description,
  inLanguage: 'es',
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  image: [ogImage],
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: {
    '@type': 'Person',
    '@id': `${siteUrl}/sobre#editor`,
    name: author,
    url: `${siteUrl}/sobre`,
    jobTitle: 'Editor técnico — Bitcoin Sin Ruido',
    description:
      'Editor técnico de Bitcoin Sin Ruido. Cubre protocolo Bitcoin, Lightning Network, BitVM, Taproot, covenants y criptografía postcuántica. Investigación basada en bitcoin-dev, BIPs y Bitcoin Optech.',
    knowsAbout: [
      'Bitcoin',
      'Lightning Network',
      'BitVM',
      'Taproot',
      'Schnorr signatures',
      'Covenants',
      'Proof of Work',
      'UTXO model',
      'BIP-360',
      'Bitcoin scalability',
    ],
    sameAs: [
      'https://x.com/BitcoinSinRuido',
      'https://paragraph.com/@bitcoinsinruido',
      `${siteUrl}/sobre`,
      `${siteUrl}/metodologia`,
    ],
  },
  publisher: { '@id': `${siteUrl}/#organization` },
  keywords: [...new Set([...keywords, ...tags])].join(', '),
  articleSection: capa,
  isAccessibleForFree: true,
  wordCount: readingTime ? readingTime * 220 : undefined,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Artículos', item: `${siteUrl}/articulos/` },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
};

const faqLd = faqs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.answer,
        },
      })),
    }
  : null;

const allKeywords = [...new Set([...keywords, ...tags])];
---

<BaseLayout
  title={seoTitle}
  description={description}
  image={ogImagePath}
  keywords={allKeywords}
  canonical={url}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={publishedAt.toISOString()} />
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <meta property="article:section" content={capa} />
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <JsonLd data={articleLd} />
    <JsonLd data={breadcrumbLd} />
    {faqLd && <JsonLd data={faqLd} />}
  </Fragment>

  <article class="container-reading py-12 sm:py-16 animate-fade-in">
    <Breadcrumbs items={[
      { name: 'Inicio', href: '/' },
      { name: 'Artículos', href: '/articulos' },
      { name: title },
    ]} />

    <header class="mb-10">
      <div class="flex flex-wrap gap-2 mb-4">
        <span class="chip-btc">Capa · {capa}</span>
        {tags.map((tag) => <span class="chip">#{tag}</span>)}
      </div>
      <h1 class="text-h1 font-semibold tracking-tight text-balance text-ink">{title}</h1>
      <p class="mt-4 text-lg text-ink-muted text-pretty">{description}</p>
      <ArticleMeta publishedAt={publishedAt} updatedAt={updatedAt} author={author} readingTime={readingTime} />
    </header>

    <div class="prose-bsr">
      <slot />
    </div>

    <div class="mt-12 pt-8 border-t border-line">
      <ShareButtons url={url} title={title} description={description} />
    </div>

    <Faq items={faqs} />
    <RelatedLinks slugs={related} currentSlug={slug} />

    <footer class="mt-16 pt-8 border-t border-line flex flex-wrap items-center justify-between gap-4">
      <a href="/articulos/" class="btn">← Todos los artículos</a>
      <a href="/glosario/" class="text-sm text-ink-muted hover:text-btc transition">¿Dudas con un término? → Glosario</a>
    </footer>
  </article>
</BaseLayout>
