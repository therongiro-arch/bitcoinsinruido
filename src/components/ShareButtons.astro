---
// Social-share buttons.
//
// Privacy: all networks use their official *intent URLs* (twitter/intent,
// linkedin/sharing, wa.me, t.me/share, reddit/submit, mailto). No third-party
// scripts, no pixels, no trackers — coherent with /privacidad.
//
// On supported devices the "Compartir" button uses the native Web Share API
// (navigator.share), opening the OS share sheet so users can pick TikTok,
// Signal, Instagram DM, AirDrop, etc.
//
// Usage:
//   <ShareButtons url="https://..." title="..." description="..." />
//
// `via` is the X handle to credit (without @). Defaults to BitcoinSinRuido.

export interface Props {
  url: string;
  title: string;
  description?: string;
  via?: string;
  compact?: boolean;
  align?: 'left' | 'center';
}

const {
  url,
  title,
  description = '',
  via = 'BitcoinSinRuido',
  compact = false,
  align = 'left',
} = Astro.props;

const encUrl = encodeURIComponent(url);
const encTitle = encodeURIComponent(title);
const encDesc = encodeURIComponent(description);

// Twitter intent: title + via + url
const twitterUrl = `https://twitter.com/intent/tweet?url=${encUrl}&text=${encTitle}&via=${via}`;
// LinkedIn: solo url
const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encUrl}`;
// WhatsApp: title + url combinados en el mensaje
const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(`${title}\n${url}`)}`;
// Telegram
const telegramUrl = `https://t.me/share/url?url=${encUrl}&text=${encTitle}`;
// Reddit submit
const redditUrl = `https://reddit.com/submit?url=${encUrl}&title=${encTitle}`;
// Email
const emailUrl = `mailto:?subject=${encTitle}&body=${encodeURIComponent(`${description}\n\n${url}`)}`;
---

<aside
  aria-label="Compartir este artículo"
  class:list={[
    'share-root not-prose',
    align === 'center' ? 'text-center' : 'text-left',
  ]}
  data-share-root
  data-share-url={url}
  data-share-title={title}
  data-share-text={description}
>
  {!compact && (
    <p class="text-xs font-mono uppercase tracking-wider text-ink-dim mb-3">
      Compartir este artículo
    </p>
  )}

  <div
    class:list={[
      'flex flex-wrap items-center gap-2',
      align === 'center' ? 'justify-center' : 'justify-start',
    ]}
  >
    <!-- Native Web Share — only shown when navigator.share is available -->
    <button
      type="button"
      data-share-native
      hidden
      class="share-btn-primary"
      aria-label="Compartir mediante el sistema"
      title="Compartir mediante el sistema"
    >
      <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="18" cy="5" r="3" />
        <circle cx="6" cy="12" r="3" />
        <circle cx="18" cy="19" r="3" />
        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
      </svg>
      <span>Compartir</span>
    </button>

    <!-- X (Twitter) -->
    <a
      href={twitterUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn"
      aria-label="Compartir en X"
      title="Compartir en X"
    >
      <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
    </a>

    <!-- LinkedIn -->
    <a
      href={linkedinUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn"
      aria-label="Compartir en LinkedIn"
      title="Compartir en LinkedIn"
    >
      <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor" aria-hidden="true">
        <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM8.339 18.338V9.667H5.667v8.671zM7 8.421a1.55 1.55 0 1 0 0-3.1 1.55 1.55 0 0 0 0 3.1m11.339 9.917v-4.751c0-2.474-1.337-3.625-3.121-3.625-1.44 0-2.085.792-2.444 1.348V9.667h-2.673c.035.754 0 8.671 0 8.671h2.673v-4.842c0-.24.017-.48.088-.652.193-.481.633-.978 1.371-.978.967 0 1.354.737 1.354 1.818v4.654z"/>
      </svg>
    </a>

    <!-- WhatsApp -->
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn"
      aria-label="Compartir en WhatsApp"
      title="Compartir en WhatsApp"
    >
      <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/>
      </svg>
    </a>

    <!-- Telegram -->
    <a
      href={telegramUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn"
      aria-label="Compartir en Telegram"
      title="Compartir en Telegram"
    >
      <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor" aria-hidden="true">
        <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0m4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635"/>
      </svg>
    </a>

    <!-- Reddit -->
    <a
      href={redditUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn"
      aria-label="Compartir en Reddit"
      title="Compartir en Reddit"
    >
      <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor" aria-hidden="true">
        <path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0m5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/>
      </svg>
    </a>

    <!-- Email -->
    <a
      href={emailUrl}
      class="share-btn"
      aria-label="Compartir por email"
      title="Compartir por email"
    >
      <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
        <polyline points="22,6 12,13 2,6" />
      </svg>
    </a>

    <!-- Copy link -->
    <button
      type="button"
      data-copy-link
      class="share-btn"
      aria-label="Copiar enlace"
      title="Copiar enlace"
    >
      <span data-copy-icon>
        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
        </svg>
      </span>
      <span data-copy-ok hidden>
        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12" />
        </svg>
      </span>
    </button>
  </div>
</aside>

<style>
  .share-btn {
    @apply inline-flex items-center justify-center w-9 h-9 rounded-full border border-line text-ink-muted transition;
  }
  .share-btn:hover,
  .share-btn:focus-visible {
    @apply text-btc border-btc/60 bg-bg-card/40;
  }
  .share-btn-primary {
    @apply inline-flex items-center gap-1.5 h-9 px-3.5 rounded-full bg-btc text-bg text-sm font-semibold transition;
  }
  .share-btn-primary:hover,
  .share-btn-primary:focus-visible {
    @apply opacity-90;
  }
  .share-btn[data-copy-link][data-copied="true"] {
    @apply text-btc border-btc/60;
  }
</style>

<script>
  // Wire up native share + copy-to-clipboard once per page.
  // Multiple ShareButtons instances coexist (we render both at the top and the
  // bottom of long articles) so we attach handlers to every node found.
  function setupShareButtons() {
    const roots = document.querySelectorAll<HTMLElement>('[data-share-root]');
    if (!roots.length) return;

    const canNativeShare =
      typeof navigator !== 'undefined' &&
      typeof (navigator as any).share === 'function';

    roots.forEach((root) => {
      const url = root.dataset.shareUrl ?? window.location.href;
      const title = root.dataset.shareTitle ?? document.title;
      const text = root.dataset.shareText ?? '';

      // Native share button — reveal only on capable devices
      const nativeBtn = root.querySelector<HTMLButtonElement>('[data-share-native]');
      if (nativeBtn) {
        if (canNativeShare) {
          nativeBtn.hidden = false;
          nativeBtn.addEventListener('click', async () => {
            try {
              await (navigator as any).share({ title, text, url });
            } catch {
              /* user cancelled or browser blocked — silent */
            }
          });
        }
      }

      // Copy link
      const copyBtn = root.querySelector<HTMLButtonElement>('[data-copy-link]');
      const copyIcon = root.querySelector<HTMLElement>('[data-copy-icon]');
      const copyOk = root.querySelector<HTMLElement>('[data-copy-ok]');
      if (copyBtn && copyIcon && copyOk) {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(url);
            copyBtn.dataset.copied = 'true';
            copyBtn.setAttribute('aria-label', 'Enlace copiado');
            copyBtn.setAttribute('title', 'Enlace copiado');
            copyIcon.hidden = true;
            copyOk.hidden = false;
            setTimeout(() => {
              copyBtn.dataset.copied = 'false';
              copyBtn.setAttribute('aria-label', 'Copiar enlace');
              copyBtn.setAttribute('title', 'Copiar enlace');
              copyIcon.hidden = false;
              copyOk.hidden = true;
            }, 1800);
          } catch {
            /* clipboard blocked (e.g. insecure context) — silent */
          }
        });
      }
    });
  }

  // Hook on initial load and on Astro client-side navigations.
  setupShareButtons();
  document.addEventListener('astro:page-load', setupShareButtons);
</script>
