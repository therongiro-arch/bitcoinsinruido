---
export interface FaqItem {
  question: string;
  answer: string;
}
export interface Props {
  items: FaqItem[];
  title?: string;
}
const { items, title = 'Preguntas frecuentes' } = Astro.props;
---
{items.length > 0 && (
  <section class="mt-16 pt-10 border-t border-line" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="text-h2 font-semibold tracking-tight text-ink mb-6">{title}</h2>
    <div class="space-y-4">
      {items.map((item) => (
        <details class="group rounded-lg border border-line bg-bg-elev/40 p-4 sm:p-5 open:border-btc/40 transition">
          <summary class="cursor-pointer list-none flex items-start gap-3 font-semibold text-ink">
            <span class="text-btc font-mono shrink-0 transition group-open:rotate-45">+</span>
            <span>{item.question}</span>
          </summary>
          <div class="mt-3 pl-7 text-ink-muted text-pretty leading-relaxed">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </section>
)}
