---
import { getCollection } from 'astro:content';

export interface Props {
  slugs: string[];
  currentSlug?: string;
  title?: string;
}

const { slugs, currentSlug, title = 'Relacionado' } = Astro.props;

const all = await getCollection('articulos', ({ data }) => !data.draft);
const map = new Map<string, (typeof all)[number]>(all.map((e) => [e.slug, e]));

const items = slugs
  .filter((s) => s !== currentSlug)
  .map((s) => map.get(s))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));
---
{items.length > 0 && (
  <section class="mt-14 pt-8 border-t border-line" aria-labelledby="related-heading">
    <h2 id="related-heading" class="text-xs uppercase tracking-wider font-mono text-ink-muted mb-4">{title}</h2>
    <ul class="grid gap-2 sm:grid-cols-2">
      {items.map((entry) => (
        <li>
          <a
            href={`/articulos/${entry.slug}`}
            class="block rounded-lg border border-line p-4 hover:border-btc/60 hover:bg-bg-elev/40 transition"
          >
            <p class="text-xs font-mono uppercase tracking-wider text-ink-dim mb-1">{entry.data.capa}</p>
            <p class="font-semibold text-ink leading-snug">{entry.data.title}</p>
            <p class="mt-1 text-sm text-ink-muted line-clamp-2">{entry.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
