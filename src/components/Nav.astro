---
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/articulos', label: 'Artículos' },
  { href: '/news', label: 'BitcoinNews' },
];
---

<header class="sticky top-0 z-40 border-b border-line/60 nav-glass">
  <nav class="container-wide flex items-center justify-between h-14">
    <a href="/" class="flex items-center gap-2 group" aria-label="Bitcoin Sin Ruido — Inicio">
      <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-btc text-bg font-bold text-sm leading-none">₿</span>
      <span class="font-semibold tracking-tight text-ink group-hover:text-btc transition">
        Bitcoin <span class="text-ink-muted font-normal">Sin Ruido</span>
      </span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="hidden md:flex items-center gap-1 sm:gap-3 text-sm">
        {links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                'px-2 sm:px-3 py-1.5 rounded-md transition',
                isActive(href)
                  ? 'text-btc'
                  : 'text-ink-muted hover:text-ink',
              ]}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
      <a
        href="https://x.com/BitcoinSinRuido"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Síguenos en X"
        title="Síguenos en X"
        class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-line text-ink-muted hover:text-btc hover:border-btc/60 transition"
      >
        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
        </svg>
      </a>
      <a
        href="https://paragraph.com/@bitcoinsinruido"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 h-9 px-3 sm:px-4 rounded-full text-xs sm:text-sm font-semibold bg-btc text-bg hover:opacity-90 transition whitespace-nowrap"
      >
        <span class="hidden sm:inline">Newsletter</span>
        <span class="sm:hidden">News</span>
        <span class="text-bg/70 hidden sm:inline">gratis</span>
        <svg viewBox="0 0 16 16" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" />
        </svg>
      </a>
    </div>
  </nav>
</header>
