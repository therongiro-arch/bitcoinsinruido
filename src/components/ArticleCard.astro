---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'articulos'>;
  big?: boolean;
}

const { entry, big = false } = Astro.props;
const { data } = entry;

const fmt = (d: Date) =>
  d.toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' });

// Pick a viz pattern from a stable hash of the slug so the same article
// always shows the same generative artwork.
const seed = entry.slug.split('').reduce((acc, c) => acc + c.charCodeAt(0), 0);
const viz = seed % 4;
---

<a href={`/articulos/${entry.slug}`} class:list={['bsr-card group', big && 'big']}>
  <div class="bsr-card-image">
    {viz === 0 && (
      <div class="bsr-viz bsr-viz-bg-grid">
        <svg viewBox="0 0 200 140" aria-hidden="true">
          <circle class="bsr-viz-glow" cx="100" cy="70" r="42" />
          <g stroke="currentColor" fill="none" stroke-width="1.2">
            <circle cx="100" cy="70" r="34" opacity="0.45" />
            <circle cx="100" cy="70" r="50" opacity="0.25" />
          </g>
          <circle class="bsr-viz-pulse" cx="100" cy="70" r="4" fill="currentColor" />
          <circle class="bsr-viz-pulse d2" cx="56" cy="42" r="3" fill="currentColor" opacity="0.6" />
          <circle class="bsr-viz-pulse d3" cx="148" cy="92" r="3" fill="currentColor" opacity="0.6" />
        </svg>
      </div>
    )}
    {viz === 1 && (
      <div class="bsr-viz bsr-viz-bg-dots">
        <svg viewBox="0 0 200 140" aria-hidden="true">
          <rect class="bsr-viz-glow" x="64" y="38" width="72" height="64" rx="6" />
          <g stroke="currentColor" fill="none" stroke-width="1.2">
            <rect x="64" y="38" width="72" height="64" rx="6" />
            <line x1="64" y1="62" x2="136" y2="62" />
            <line x1="64" y1="82" x2="136" y2="82" />
          </g>
          <path class="bsr-viz-edge" d="M16 70 L60 70 M140 70 L184 70" />
        </svg>
      </div>
    )}
    {viz === 2 && (
      <div class="bsr-viz bsr-viz-bg-grid">
        <svg viewBox="0 0 200 140" aria-hidden="true">
          <path class="bsr-viz-glow" d="M30 110 L70 60 L100 90 L140 40 L170 70" fill="none" stroke="currentColor" stroke-width="6" />
          <path class="bsr-viz-edge" d="M30 110 L70 60 L100 90 L140 40 L170 70" />
          <g fill="currentColor">
            <circle class="bsr-viz-pulse" cx="70" cy="60" r="3" />
            <circle class="bsr-viz-pulse d2" cx="100" cy="90" r="3" />
            <circle class="bsr-viz-pulse d3" cx="140" cy="40" r="3" />
          </g>
        </svg>
      </div>
    )}
    {viz === 3 && (
      <div class="bsr-viz bsr-viz-bg-dots">
        <svg viewBox="0 0 200 140" aria-hidden="true">
          <g stroke="currentColor" fill="none" stroke-width="1.2">
            <rect x="50" y="48" width="32" height="44" rx="3" />
            <rect x="92" y="48" width="32" height="44" rx="3" />
            <rect x="134" y="48" width="32" height="44" rx="3" />
          </g>
          <path class="bsr-viz-edge" d="M82 70 L92 70 M124 70 L134 70" />
          <circle class="bsr-viz-glow" cx="100" cy="70" r="56" />
        </svg>
      </div>
    )}
  </div>
  <div class="bsr-card-meta">
    <span class="bsr-card-pill">{data.capa}</span>
    <span aria-hidden="true">·</span>
    <time datetime={data.publishedAt.toISOString()}>{fmt(data.publishedAt)}</time>
  </div>
  <h3 class="bsr-card-title">{data.title}</h3>
  <p class="bsr-card-snippet">{data.description}</p>
</a>
