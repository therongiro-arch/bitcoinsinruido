---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ArticleCard from '../components/ArticleCard.astro';
import HomeBackground from '../components/HomeBackground.astro';
import NewsFeed from '../components/react/NewsFeed.tsx';
import JsonLd from '../components/JsonLd.astro';

const articulos = (await getCollection('articulos', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 6);

const homeFaqs = [
  {
    question: '¿Qué es Bitcoin Sin Ruido?',
    answer:
      'Una publicación técnica en español sobre el protocolo de Bitcoin: Lightning, Taproot, BitVM, covenants, escalabilidad y futuro. Sin predicciones de precio, sin hype.',
  },
  {
    question: '¿Por dónde empezar a entender Bitcoin?',
    answer:
      'Leer la guía pillar "Qué es Bitcoin", luego UTXO, Proof of Work y nodos. Después saltar a Lightning Network y al glosario para los términos sueltos.',
  },
  {
    question: '¿Cubren precio, predicciones o trading?',
    answer:
      'No. Bitcoin Sin Ruido cubre exclusivamente el protocolo y su evolución técnica. No se publican llamadas a comprar, vender ni predicciones.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Últimos artículos de Bitcoin Sin Ruido',
  itemListElement: articulos.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://bitcoinsinruidos.com/articulos/${a.slug}`,
    name: a.data.title,
  })),
};
---

<BaseLayout
  title="Bitcoin Sin Ruido — Bitcoin desde el protocolo, sin ruido de precio"
  description="Referencia técnica de Bitcoin en español: Lightning, Taproot, BitVM, covenants, escalabilidad y futuro. Sin predicciones de precio, sin hype."
  keywords={["Bitcoin español", "qué es Bitcoin", "Bitcoin protocolo", "Lightning Network", "BitVM", "Taproot", "Bitcoin sin ruido"]}
>
  <Fragment slot="head">
    <JsonLd data={faqLd} />
    <JsonLd data={itemListLd} />
  </Fragment>
  <HomeBackground />
  <Hero />

  <!-- Bloque textual SEO -->
  <section class="container-reading py-12 sm:py-16 border-b border-line">
    <div class="prose-bsr">
      <h2>Qué es Bitcoin Sin Ruido</h2>
      <p>
        <strong>Bitcoin Sin Ruido</strong> es un medio técnico en español enfocado en explicar
        Bitcoin desde el protocolo. Aquí no se habla de precio, no se publican predicciones ni
        se recomiendan compras o ventas: se explica <strong>cómo funciona Bitcoin a nivel
        técnico</strong>, capa por capa, mejora por mejora, decisión por decisión.
      </p>
      <p>
        El objetivo es uno solo: que cualquier hispanohablante con curiosidad pueda entender
        Bitcoin como protocolo y como red, con la profundidad necesaria para tomar decisiones
        informadas y la claridad suficiente para no quedarse fuera por jerga.
      </p>

      <h2>Qué aprenderás en esta web</h2>
      <ul>
        <li><a href="/que-es-bitcoin">Qué es Bitcoin</a> y cómo funciona desde el protocolo.</li>
        <li><a href="/utxo">Qué son los UTXOs</a> y por qué Bitcoin no usa cuentas.</li>
        <li><a href="/articulos/proof-of-work">Cómo funciona Proof of Work</a> y por qué la energía es la seguridad.</li>
        <li><a href="/articulos/nodos-los-guardianes">Qué hacen los nodos</a> y por qué son los verdaderos guardianes de la red.</li>
        <li><a href="/lightning-network">Qué es Lightning Network</a> y cómo escala Bitcoin.</li>
        <li><a href="/taproot">Qué es Taproot</a>, las firmas Schnorr y MuSig2.</li>
        <li><a href="/bitvm">Qué es BitVM</a> y cómo habilita contratos sin soft fork.</li>
        <li><a href="/articulos/covenants">Qué son los covenants</a> (OP_CAT, CTV).</li>
        <li><a href="/articulos/bip360-resistencia-cuantica">Cómo se prepara Bitcoin frente a la computación cuántica</a> (BIP-360).</li>
        <li><a href="/escalabilidad-bitcoin">Cómo escala Bitcoin</a> sin tocar la capa base.</li>
        <li><a href="/futuro-bitcoin">Hacia dónde va Bitcoin</a>: covenants, rollups y cuántico.</li>
      </ul>

      <h2>Qué encontrarás en Bitcoin Sin Ruido</h2>
      <ul>
        <li><strong>Guías técnicas</strong> sobre el protocolo, las L2 y la criptografía detrás.</li>
        <li><strong>Explicaciones paso a paso</strong> de conceptos clave: UTXO, Lightning, Taproot, BitVM.</li>
        <li><strong>Comparativas</strong> sin tribalismo: <a href="/comparativas/bitcoin-vs-ethereum">Bitcoin vs Ethereum</a>, <a href="/comparativas/lightning-vs-visa">Lightning vs Visa</a>, <a href="/comparativas/bitvm-vs-smart-contracts">BitVM vs smart contracts</a>.</li>
        <li><strong>Glosario Bitcoin</strong> en español con <a href="/glosario">30+ términos técnicos</a>.</li>
        <li><strong>Casos prácticos</strong>: remesas, autocustodia, stablecoins, micropagos.</li>
        <li><strong>BitcoinNews</strong>: titulares filtrados de fuentes técnicas, sin clickbait.</li>
      </ul>

      <h2>Cómo está organizada la web</h2>
      <p>
        El contenido se estructura en cuatro entradas naturales: las
        <a href="/articulos">guías y artículos</a> ordenados por capa
        (protocolo, L2, privacidad, futuro), las
        <a href="/que-es-bitcoin">páginas pillar</a> de los conceptos centrales,
        las <a href="/comparativas">comparativas técnicas</a> y el
        <a href="/glosario">glosario</a> para consultar términos sueltos.
        Si vienes por primera vez, el orden recomendado es:
        <a href="/que-es-bitcoin">Qué es Bitcoin</a> →
        <a href="/utxo">UTXOs</a> →
        <a href="/articulos/proof-of-work">Proof of Work</a> →
        <a href="/lightning-network">Lightning Network</a> →
        <a href="/taproot">Taproot</a> →
        <a href="/bitvm">BitVM</a>.
      </p>
    </div>
  </section>

  <!-- Últimos artículos -->
  <section class="container-wide py-16 sm:py-20">
    <header class="flex flex-wrap items-end justify-between gap-4 mb-10">
      <div>
        <p class="chip font-mono mb-3">PROTOCOLO</p>
        <h2 class="text-h2 font-semibold tracking-tight text-balance">
          Últimos artículos
        </h2>
        <p class="mt-2 text-ink-muted max-w-prose">
          Bitcoin explicado desde lo que importa: cómo funciona, no a cuánto está.
        </p>
      </div>
      <a href="/articulos" class="btn">Ver todos →</a>
    </header>

    <div class="grid gap-4 sm:gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {articulos.map((entry) => <ArticleCard entry={entry} />)}
    </div>
  </section>

  <!-- BitcoinNews preview -->
  <section class="container-wide py-16 sm:py-20 border-t border-line">
    <header class="flex flex-wrap items-end justify-between gap-4 mb-10">
      <div>
        <p class="chip-btc font-mono mb-3">EN VIVO · DIARIO</p>
        <h2 class="text-h2 font-semibold tracking-tight text-balance">
          BitcoinNews
        </h2>
        <p class="mt-2 text-ink-muted max-w-prose">
          Titulares filtrados de fuentes técnicas y editoriales. Sin clickbait, sin predicciones de precio.
        </p>
      </div>
      <a href="/news" class="btn">Ver todo el feed →</a>
    </header>

    <NewsFeed client:visible limit={6} compact={true} />
  </section>

  <!-- Empezar por aquí -->
  <section class="container-wide py-16 sm:py-20 border-t border-line">
    <header class="mb-10">
      <p class="chip font-mono mb-3">EMPEZAR</p>
      <h2 class="text-h2 font-semibold tracking-tight text-balance">Por dónde empezar</h2>
      <p class="mt-2 text-ink-muted max-w-prose">
        Cuatro páginas pillar que cubren el 90% de lo que hay que saber sobre Bitcoin sin tener que adivinar el orden de lectura.
      </p>
    </header>

    <div class="grid gap-4 sm:gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <a href="/bitcoin-explicado" class="block rounded-lg border border-line p-5 hover:border-btc/60 hover:bg-bg-elev/40 transition">
        <p class="text-xs font-mono uppercase tracking-wider text-ink-dim mb-1">Pillar</p>
        <h3 class="font-semibold text-ink leading-snug">Qué es Bitcoin</h3>
        <p class="mt-1 text-sm text-ink-muted">Guía técnica completa en español.</p>
      </a>
      <a href="/escalabilidad-bitcoin" class="block rounded-lg border border-line p-5 hover:border-btc/60 hover:bg-bg-elev/40 transition">
        <p class="text-xs font-mono uppercase tracking-wider text-ink-dim mb-1">Pillar</p>
        <h3 class="font-semibold text-ink leading-snug">Escalabilidad de Bitcoin</h3>
        <p class="mt-1 text-sm text-ink-muted">Lightning, BitVM, Citrea y más.</p>
      </a>
      <a href="/futuro-bitcoin" class="block rounded-lg border border-line p-5 hover:border-btc/60 hover:bg-bg-elev/40 transition">
        <p class="text-xs font-mono uppercase tracking-wider text-ink-dim mb-1">Pillar</p>
        <h3 class="font-semibold text-ink leading-snug">Futuro de Bitcoin</h3>
        <p class="mt-1 text-sm text-ink-muted">Covenants, cuántico, rollups.</p>
      </a>
      <a href="/glosario" class="block rounded-lg border border-line p-5 hover:border-btc/60 hover:bg-bg-elev/40 transition">
        <p class="text-xs font-mono uppercase tracking-wider text-ink-dim mb-1">Glosario</p>
        <h3 class="font-semibold text-ink leading-snug">Diccionario técnico</h3>
        <p class="mt-1 text-sm text-ink-muted">30+ términos esenciales.</p>
      </a>
    </div>
  </section>
</BaseLayout>
