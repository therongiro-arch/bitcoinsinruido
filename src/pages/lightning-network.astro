        <li><a href="https://mempool.space/lightning" target="_blank" rel="noopener noreferrer">mempool.space/lightning ↗</a></li>
      </ul>
    </div>

    <Faq items={faqs} />

    <footer class="mt-16 pt-8 border-t border-line">
      <a href="/articulos" class="btn">← Todos los artículos</a>
    </footer>
  </article>
</BaseLayout>
