---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · Bitcoin Sin Ruido" description="Página no encontrada." noindex={true}>
  <section class="container-wide py-24 sm:py-32 text-center">
    <p class="font-mono text-btc text-sm mb-3">404</p>
    <h1 class="text-h1 font-semibold tracking-tight">Esto no existe (todavía).</h1>
    <p class="mt-4 text-ink-muted max-w-md mx-auto">
      Lo que buscabas no está aquí. Podés volver a la portada o revisar los artículos.
    </p>
    <div class="mt-8 flex gap-3 justify-center">
      <a href="/" class="btn-primary">Inicio</a>
      <a href="/articulos/" class="btn">Artículos</a>
    </div>
  </section>
</BaseLayout>
