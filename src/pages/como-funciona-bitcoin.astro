        <li><a href="/lightning-network">Qué es Lightning Network</a></li>
        <li><a href="/taproot">Qué es Taproot</a></li>
        <li><a href="/bitvm">Qué es BitVM</a></li>
        <li><a href="/escalabilidad-bitcoin">Escalabilidad de Bitcoin</a></li>
