---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import JsonLd from '../components/JsonLd.astro';

const title = 'Qué es Bitcoin: guía técnica completa en español (2026)';
const description = 'Bitcoin explicado desde el protocolo: UTXO, Proof of Work, nodos, halving, Taproot, Lightning, BitVM y futuro postcuántico. Una guía estructurada, sin hype.';
const url = 'https://bitcoinsinruidos.com/bitcoin-explicado';

const faqs = [
  {
    question: '¿Qué es Bitcoin en una frase?',
    answer:
      'Bitcoin es una red de pagos digital, sin emisor central, cuyo suministro está fijado por código en 21 millones de unidades y cuya validez se mantiene mediante consenso distribuido (Proof of Work) entre miles de nodos independientes.',
  },
  {
    question: '¿Cómo funciona Bitcoin?',
    answer:
      'Las transacciones se firman con claves criptográficas, se propagan por la red, los mineros las agrupan en bloques y compiten gastando energía para añadir el bloque a la cadena. Los nodos verifican que cada bloque cumple las reglas; si no, lo rechazan sin votación.',
  },
  {
    question: '¿Quién controla Bitcoin?',
    answer:
      'Nadie en particular. Los desarrolladores proponen cambios, los nodos deciden si los aplican y los usuarios eligen qué software correr. No hay CEO, junta ni fundación que pueda imponer modificaciones al protocolo.',
  },
  {
    question: '¿Bitcoin es solo digital o tiene respaldo?',
    answer:
      'Bitcoin no tiene respaldo en oro ni dólares: su respaldo es energía (Proof of Work), escasez programada (21M) y descentralización (24.000+ nodos). Es comparable al oro, no al peso ni al dólar.',
  },
  {
    question: '¿Es legal Bitcoin en España y LATAM?',
    answer:
      'Bitcoin es legal en España, México, Argentina, Colombia, Chile, Perú y Uruguay. Cada país regula diferente la fiscalidad y los intermediarios (exchanges). El Salvador es el único país donde es moneda de curso legal. Sudáfrica publicó en abril de 2026 un borrador que criminalizaría la autocustodia.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://bitcoinsinruidos.com/' },
    { '@type': 'ListItem', position: 2, name: 'Bitcoin explicado', item: url },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url,
  inLanguage: 'es',
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  datePublished: '2026-05-26',
  dateModified: '2026-05-26',
  author: { '@type': 'Organization', name: 'Bitcoin Sin Ruido', url: 'https://bitcoinsinruidos.com' },
  publisher: { '@id': 'https://bitcoinsinruidos.com/#organization' },
  about: 'Bitcoin',
};
---

<BaseLayout
  title={`${title} | Bitcoin Sin Ruido`}
  description={description}
  canonical="https://bitcoinsinruidos.com/que-es-bitcoin"
  keywords={["qué es Bitcoin", "Bitcoin explicado", "cómo funciona Bitcoin", "guía Bitcoin español", "Bitcoin 2026", "Bitcoin sin ruido"]}
>
  <Fragment slot="head">
    <JsonLd data={articleLd} />
    <JsonLd data={breadcrumbLd} />
    <JsonLd data={faqLd} />
  </Fragment>

  <article class="container-reading py-12 sm:py-16 animate-fade-in">
    <Breadcrumbs items={[{ name: 'Inicio', href: '/' }, { name: 'Bitcoin explicado' }]} />

    <header class="mb-10">
      <p class="chip-btc font-mono mb-3">GUÍA PILLAR</p>
      <h1 class="text-h1 font-semibold tracking-tight text-balance text-ink">{title}</h1>
      <p class="mt-4 text-lg text-ink-muted text-pretty">{description}</p>
    </header>

    <div class="prose-bsr">
      <h2>Resumen rápido</h2>
      <p>
        <strong>Bitcoin es una red de dinero digital sin emisor central.</strong> Su suministro
        está fijado en 21 millones por código, su seguridad se sostiene en energía gastada (Proof
        of Work) y su consenso lo mantienen miles de nodos independientes. No requiere confianza
        en bancos, gobiernos ni intermediarios para operar.
      </p>

      <h2>Cómo funciona Bitcoin (en 5 pasos)</h2>
      <ol>
        <li><strong>Alice firma una transacción</strong> con su clave privada gastando uno o más <a href="/articulos/que-es-utxo">UTXOs</a>.</li>
        <li>La transacción se propaga por la red de <a href="/articulos/nodos-los-guardianes">nodos</a>, que la verifican individualmente.</li>
        <li>Los <strong>mineros</strong> compiten gastando energía para incluirla en un bloque (<a href="/articulos/proof-of-work">Proof of Work</a>).</li>
        <li>El bloque ganador se difunde; los nodos lo verifican contra las reglas del protocolo.</li>
        <li>Si cumple, se añade a la cadena. Si no, se ignora — sin votación ni autoridad central.</li>
      </ol>

      <h2>Componentes clave de Bitcoin</h2>
      <ul>
        <li><a href="/articulos/que-es-utxo"><strong>UTXOs</strong></a> — La unidad real de saldo: monedas, no cuentas.</li>
        <li><a href="/articulos/proof-of-work"><strong>Proof of Work</strong></a> — El consenso que ancla la red en energía.</li>
        <li><a href="/articulos/nodos-los-guardianes"><strong>Nodos</strong></a> — Verificadores independientes. Hay 24.000+ activos.</li>
        <li><a href="/articulos/los-21-millones"><strong>21 millones</strong></a> — Suministro fijado por matemática, no por decreto.</li>
        <li><a href="/articulos/taproot"><strong>Taproot</strong></a> — Firmas Schnorr, privacidad estructural, base de Lightning moderno.</li>
        <li><a href="/articulos/lightning-network"><strong>Lightning Network</strong></a> — Capa 2 de pagos: instantáneos, casi gratis.</li>
        <li><a href="/articulos/bitvm-y-citrea"><strong>BitVM y Citrea</strong></a> — Contratos inteligentes sin soft fork.</li>
      </ul>

      <h2>Capas de Bitcoin en 2026</h2>
      <table>
        <thead>
          <tr><th>Capa</th><th>Para qué sirve</th><th>Ejemplo</th></tr>
        </thead>
        <tbody>
          <tr><td><strong>L1 (base)</strong></td><td>Asentamiento final, reserva de valor</td><td>Transferencia on-chain de 1 BTC</td></tr>
          <tr><td><strong>L2 — Lightning</strong></td><td>Pagos instantáneos, casi gratis</td><td>Café pagado con Phoenix</td></tr>
          <tr><td><strong>L2 — Taproot Assets</strong></td><td>Stablecoins sobre Lightning</td><td>USDT por Lightning</td></tr>
          <tr><td><strong>L2 — Citrea (ZK-rollup)</strong></td><td>Contratos inteligentes</td><td>Aplicación DeFi anclada a Bitcoin</td></tr>
          <tr><td><strong>L2 — BitVM</strong></td><td>Computación verificable</td><td>Puente entre rollups</td></tr>
        </tbody>
      </table>

      <h2>Casos de uso reales</h2>
      <ul>
        <li><strong>Remesas</strong> — Lightning baja el costo de un envío internacional de ~7,2 % (Western Union) a fracciones de centavo.</li>
        <li><strong>Autocustodia</strong> — Phoenix, Mutiny, Sparrow permiten controlar fondos sin intermediario.</li>
        <li><strong>Inflación e hiperinflación</strong> — Argentina, Venezuela y Líbano son ejemplos donde BTC opera como refugio.</li>
        <li><strong>Censura y bloqueo bancario</strong> — Transacciones válidas no se pueden bloquear por jurisdicción.</li>
        <li><strong>Asentamiento de stablecoins</strong> — Taproot Assets permite USDT, MXN tokenizado y otros sobre Lightning.</li>
      </ul>

      <h2>Riesgos honestos</h2>
      <ul>
        <li><strong>Cuántico</strong> — Mitigado a futuro por <a href="/articulos/bip360-resistencia-cuantica">BIP-360</a>.</li>
        <li><strong>Regulatorio</strong> — Algunos países prohíben o restringen exchanges; la autocustodia tiende a ser más resiliente.</li>
        <li><strong>Pérdida de claves</strong> — Sin backup correcto, el bitcoin se pierde. La autocustodia es responsabilidad real.</li>
        <li><strong>Volatilidad de precio</strong> — Lo ignoramos aquí, pero es real para usos de pago directo sin stablecoin.</li>
      </ul>

      <h2>Bitcoin vs. otras alternativas</h2>
      <p>
        Comparativas detalladas: <a href="/comparativas/bitcoin-vs-ethereum">Bitcoin vs Ethereum</a>,
        <a href="/comparativas/lightning-vs-visa">Lightning vs Visa</a> y
        <a href="/comparativas/bitvm-vs-smart-contracts">BitVM vs Smart Contracts</a>.
      </p>

      <h2>Por dónde empezar</h2>
      <ol>
        <li>Lee <a href="/articulos/que-es-utxo">qué es un UTXO</a> y <a href="/articulos/proof-of-work">cómo funciona PoW</a>.</li>
        <li>Instala una wallet Lightning autocustodial (Phoenix, Mutiny, Breez).</li>
        <li>Compra un fragmento pequeño en un exchange regulado, retíralo a tu wallet.</li>
        <li>Corre un <a href="/articulos/nodos-los-guardianes">nodo completo</a> (Umbrel, Start9, RaspiBlitz).</li>
        <li>Suscríbete al <a href="https://bitcoinops.org" target="_blank" rel="noopener noreferrer">Bitcoin Optech Newsletter</a> para seguir la conversación técnica real.</li>
      </ol>

      <h2>Recursos relacionados</h2>
      <ul>
        <li><a href="/escalabilidad-bitcoin">Escalabilidad de Bitcoin</a></li>
        <li><a href="/futuro-bitcoin">Futuro de Bitcoin: BitVM, covenants y cuántico</a></li>
        <li><a href="/glosario">Glosario completo de Bitcoin</a></li>
        <li><a href="/articulos">Todos los artículos</a></li>
      </ul>
    </div>

    <Faq items={faqs} />

    <footer class="mt-16 pt-8 border-t border-line flex flex-wrap items-center justify-between gap-4">
      <a href="/articulos" class="btn">← Todos los artículos</a>
      <a href="/sobre" class="text-sm text-ink-muted hover:text-btc transition">Sobre Bitcoin Sin Ruido →</a>
    </footer>
  </article>
</BaseLayout>
