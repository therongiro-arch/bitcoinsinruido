        <li><a href="https://liquid.net" target="_blank" rel="noopener noreferrer">Liquid Network ↗</a></li>
      </ul>
    </div>

    <Faq items={faqs} />

    <footer class="mt-16 pt-8 border-t border-line">
      <a href="/articulos/" class="btn">← Todos los artículos</a>
    </footer>
  </article>
</BaseLayout>
