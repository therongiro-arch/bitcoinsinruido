---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import JsonLd from '../components/JsonLd.astro';

const title = 'Mapa del stack de Bitcoin: capas, protocolos y aplicaciones (2026)';
const description = 'El mapa completo del ecosistema Bitcoin en 2026: capa base, Lightning, Taproot Assets, BitVM, Citrea, rollups, sidechains y aplicaciones. Diagrama y referencias.';
const url = 'https://bitcoinsinruidos.com/mapa-stack-bitcoin/';
const datePublished = '2026-05-27';
const dateModified = '2026-05-27';

const faqs = [
  { question: '¿Qué es el "stack" de Bitcoin?', answer: 'El stack es el conjunto de capas y protocolos que componen el ecosistema Bitcoin: desde la cadena base (L1) hasta las aplicaciones de usuario, pasando por capas 2 (Lightning, BitVM), capas de activos (Taproot Assets), rollups (Citrea) y sidechains (Liquid).' },
  { question: '¿Cuántas capas tiene Bitcoin en 2026?', answer: 'No hay un número fijo. Por convención hablamos de L1 (cadena base), L2 (Lightning, BitVM-based rollups), capas de activos sobre L2 (Taproot Assets) y aplicaciones de usuario encima. Cada nueva capa hereda seguridad de la inferior.' },
  { question: '¿Cuál es la diferencia entre L2 y sidechain?', answer: 'Una L2 hereda la seguridad directa de Bitcoin (vía canales, fraud proofs o pruebas zk). Una sidechain (ej. Liquid) tiene consenso propio y solo se conecta por un puente federado. La L2 es trust-minimized; la sidechain requiere confianza en el federation.' },
  { question: '¿Bitcoin compite con Ethereum en aplicaciones?', answer: 'Cada vez más, vía Citrea y otras L2 BitVM-based. La diferencia es filosófica: Bitcoin mantiene la capa base simple y la programabilidad vive encima. Ethereum ejecuta la programabilidad en su L1.' },
  { question: '¿Dónde se asientan las stablecoins en Bitcoin?', answer: 'En 2026, principalmente sobre Lightning vía Taproot Assets (USDT nativo desde 2025) y sobre Liquid Network (USDt, EURx). Citrea añade soporte para stablecoins EVM-compatible.' },
  { question: '¿Qué falta por construir en el stack?', answer: 'Pendientes notables: covenants en L1 (OP_CAT, CTV), maduración de puentes BitVM trust-minimized, despliegue mainnet de BIP-360 (postcuántico), y mejoras de privacidad en Lightning (PTLCs, BLIP-0050).' },
];

const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description, url, inLanguage: 'es',
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  datePublished, dateModified,
  author: { '@type': 'Person', '@id': 'https://bitcoinsinruidos.com/sobre#editor', name: 'Bitcoin Sin Ruido', url: 'https://bitcoinsinruidos.com/sobre/' },
  publisher: { '@id': 'https://bitcoinsinruidos.com/#organization' },
  about: 'Bitcoin ecosystem',
};
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://bitcoinsinruidos.com/' },
    { '@type': 'ListItem', position: 2, name: 'Mapa del stack de Bitcoin', item: url },
  ],
};
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
};
---

<BaseLayout title={`${title} | Bitcoin Sin Ruido`} description={description} canonical={url} keywords={["mapa stack Bitcoin", "ecosistema Bitcoin 2026", "capas Bitcoin", "L1 L2 Bitcoin", "Lightning BitVM Citrea", "Taproot Assets"]}>
  <Fragment slot="head">
    <JsonLd data={articleLd} />
    <JsonLd data={breadcrumbLd} />
    <JsonLd data={faqLd} />
  </Fragment>

  <article class="container-reading py-12 sm:py-16 animate-fade-in">
    <Breadcrumbs items={[{ name: 'Inicio', href: '/' }, { name: 'Mapa del stack de Bitcoin' }]} />
    <header class="mb-10">
      <p class="chip-btc font-mono mb-3">REFERENCIA · ECOSISTEMA</p>
      <h1 class="text-h1 font-semibold tracking-tight text-balance text-ink">{title}</h1>
      <p class="mt-4 text-lg text-ink-muted text-pretty">{description}</p>
    </header>

    <div class="prose-bsr">
      <h2>Resumen rápido</h2>
      <p>
        El stack de <a href="/que-es-bitcoin/">Bitcoin</a> en 2026 es una pila de capas que escalan velocidad, costo y expresividad sin tocar la base. <strong>L1</strong> es la cadena de bloques asegurada por <a href="/articulos/proof-of-work/">Proof of Work</a>. Encima conviven <a href="/lightning-network/">Lightning Network</a> (pagos), <a href="/articulos/taproot-assets/">Taproot Assets</a> (stablecoins), <a href="/bitvm/">BitVM</a>/<a href="/articulos/bitvm-y-citrea/">Citrea</a> (contratos), <strong>Liquid</strong> (sidechain federada) y aplicaciones de usuario. Esta página recorre cada capa, qué función cumple y quién está construyendo en ella.
      </p>

      <h2>Diagrama del stack</h2>
      <pre><code>┌─────────────────────────────────────────────────────────────┐
│  APLICACIONES DE USUARIO                                    │
│  Phoenix · Mutiny · Sparrow · Strike · Cash App · BTCPay   │
├─────────────────────────────────────────────────────────────┤
│  CAPAS DE ACTIVOS                                           │
│  Taproot Assets (USDT, USDC) · RGB · Ordinals · Runes      │
├─────────────────────────────────────────────────────────────┤
│  CAPA 2 — PAGOS Y CONTRATOS                                 │
│  Lightning Network    │    BitVM / Citrea (ZK-rollup)       │
│  HTLCs · canales      │    fraud proofs · Clementine bridge │
├─────────────────────────────────────────────────────────────┤
│  SIDECHAINS / FEDERATED                                     │
│  Liquid · RSK · Stacks                                      │
├─────────────────────────────────────────────────────────────┤
│  CAPA 1 — BITCOIN BASE                                      │
│  Proof of Work · UTXO · Schnorr/Taproot · 21M cap · Nodos  │
└─────────────────────────────────────────────────────────────┘</code></pre>

      <h2>Capa 1 — Bitcoin base</h2>
      <p>
        La capa base es la blockchain de Bitcoin: bloques cada ~10 minutos, asegurados por <a href="/articulos/proof-of-work/">Proof of Work</a>, verificados por más de 24.000 <a href="/que-es-un-nodo-bitcoin/">nodos</a>. Es la capa de máxima seguridad, finalidad y descentralización, y por eso es deliberadamente lenta y limitada en throughput.
      </p>
      <ul>
        <li><strong>Componentes</strong> — Bitcoin Core, btcd, Knots, libbitcoin.</li>
        <li><strong>Throughput</strong> — ~7 tx/s en condiciones normales.</li>
        <li><strong>Coste típico</strong> — 0,5-10 USD por tx.</li>
        <li><strong>Función</strong> — Asentamiento final, reserva de valor, anclaje para las capas superiores.</li>
        <li><strong>Mejoras activas</strong> — <a href="/taproot/">Taproot</a> (2021), <a href="/articulos/bip360-resistencia-cuantica/">BIP-360</a> en testnet.</li>
      </ul>

      <h2>Capa 2 — Lightning Network</h2>
      <p>
        <a href="/lightning-network/">Lightning</a> es la L2 más madura. Red de canales bidireccionales que permite pagos instantáneos y casi gratuitos. En 2026 mueve más de 12 millones de tx al mes sobre 18.000+ nodos públicos.
      </p>
      <ul>
        <li><strong>Implementaciones</strong> — LDK (Spiral), Eclair (ACINQ), c-lightning (Blockstream), LND (Lightning Labs).</li>
        <li><strong>Wallets de usuario</strong> — Phoenix, Mutiny, Breez, Wallet of Satoshi (custodial), Cash App, Strike.</li>
        <li><strong>Infra empresarial</strong> — Voltage, Galoy, LNbits, BTCPay Server, OpenNode.</li>
        <li><strong>Características 2026</strong> — Splicing, AMP, BOLT12 offers, taproot channels (gossip v2 en progreso).</li>
      </ul>

      <h2>Capa 2 — BitVM y Citrea</h2>
      <p>
        <a href="/bitvm/">BitVM</a> permite verificar computación arbitraria sobre Bitcoin con fraud proofs. <a href="/articulos/bitvm-y-citrea/">Citrea</a> es el primer ZK-rollup nativo, mainnet desde enero de 2026.
      </p>
      <ul>
        <li><strong>Citrea</strong> — ZK-rollup EVM-compatible anclado a Bitcoin vía puente Clementine.</li>
        <li><strong>BitVM2</strong> — Mejoras al modelo original para reducir costos de challenge.</li>
        <li><strong>Otras implementaciones</strong> — Bitlayer, BOB, Yona — competidores con enfoques distintos.</li>
        <li><strong>Aplicaciones</strong> — DeFi anclado a Bitcoin, oráculos, mercados de predicción, puentes trust-minimized.</li>
      </ul>

      <h2>Capa de activos — Taproot Assets, RGB y ordinales</h2>
      <ul>
        <li><strong><a href="/articulos/taproot-assets/">Taproot Assets</a></strong> (Lightning Labs) — Stablecoins y tokens nativos sobre Bitcoin que viajan por Lightning. USDT nativo desde 2025.</li>
        <li><strong>RGB</strong> — Protocolo alternativo de smart contracts y activos sobre Bitcoin/Lightning, con un modelo de validación cliente.</li>
        <li><strong>Ordinals / Runes</strong> — Inscripciones de datos arbitrarios y tokens fungibles sobre <a href="/utxo/">UTXOs</a>. Controvertidos por el uso de espacio en bloque.</li>
      </ul>

      <h2>Sidechains federadas</h2>
      <ul>
        <li><strong>Liquid Network</strong> (Blockstream) — Sidechain federada para asentamiento más rápido (1 min) y confidential transactions. USDt, USDC y EURx emitidos aquí.</li>
        <li><strong>Rootstock (RSK)</strong> — EVM-compatible sobre Bitcoin con merged mining. Llevaba años en producción antes de Citrea.</li>
        <li><strong>Stacks</strong> — Smart contracts con Clarity, asentamiento PoX hacia Bitcoin. Estatus de "L2" debatido.</li>
      </ul>

      <h2>Aplicaciones de usuario en 2026</h2>
      <h3>Custodiales (entrada fácil)</h3>
      <ul>
        <li><strong>Cash App</strong> — Lightning y on-chain en 4M+ terminales Square.</li>
        <li><strong>Strike</strong> — Remesas Lightning en 85+ países.</li>
        <li><strong>Coinbase, Binance, Kraken</strong> — Exchanges con custodia integrada.</li>
        <li><strong>Wallet of Satoshi</strong> — Custodial Lightning, popular en LATAM.</li>
      </ul>
      <h3>Autocustodiales (soberanía completa)</h3>
      <ul>
        <li><strong>Phoenix</strong> (ACINQ) — Lightning autocustodial móvil.</li>
        <li><strong>Mutiny</strong> — Web/PWA autocustodial con Taproot Assets.</li>
        <li><strong>Sparrow</strong> — Desktop con multisig avanzado.</li>
        <li><strong>Bitcoin Core</strong> — Nodo completo + wallet.</li>
        <li><strong>BlueWallet, Breez</strong> — Móvil con varios modos.</li>
        <li><strong>Trezor, Ledger, Coldcard</strong> — Hardware wallets para almacenamiento frío.</li>
      </ul>

      <h2>Cómo eligen las capas los desarrolladores</h2>
      <table>
        <thead>
          <tr><th>Necesito...</th><th>Capa óptima</th><th>Por qué</th></tr>
        </thead>
        <tbody>
          <tr><td>Asentamiento final con máxima seguridad</td><td>L1</td><td>Finalidad PoW + descentralización</td></tr>
          <tr><td>Pagos instantáneos &lt;1 USD</td><td>Lightning</td><td>Velocidad y costo óptimos</td></tr>
          <tr><td>Stablecoins sin gas tokens</td><td>Taproot Assets / Liquid</td><td>USDT nativo, EURx</td></tr>
          <tr><td>Smart contracts EVM-compatible</td><td>Citrea</td><td>Hereda seguridad Bitcoin</td></tr>
          <tr><td>Privacidad por defecto en pagos</td><td>Liquid / Lightning + CoinJoin</td><td>Confidential tx / onion routing</td></tr>
          <tr><td>Inscripciones / NFTs</td><td>Ordinals / Runes</td><td>Persistencia on-chain</td></tr>
        </tbody>
      </table>

      <h2>Qué está aún en construcción</h2>
      <ul>
        <li><a href="/articulos/covenants/">Covenants</a> (OP_CAT, CTV) — Habilitarían vaults y mejores L2.</li>
        <li>Maduración de BitVM y puentes trust-minimized.</li>
        <li>Despliegue mainnet de <a href="/articulos/bip360-resistencia-cuantica/">BIP-360</a> (resistencia cuántica).</li>
        <li>PTLCs en Lightning (mejores privacidad y compatibilidad con Taproot Assets).</li>
        <li>Estandarización de BOLT12 (offers reutilizables).</li>
      </ul>

      <h2>Cómo encaja todo: ejemplo de remesa LATAM</h2>
      <p>
        Carla en España quiere enviar 500 € a su familia en Colombia. Usa Strike: convierte EUR a BTC, los manda por Lightning a un agente local en Bogotá. El agente paga en pesos al destinatario. Total: minutos, fee inferior a 1 USD. Por debajo, ocurrió esto:
      </p>
      <ol>
        <li>L1 → Strike tiene reservas BTC ancladas en Bitcoin base.</li>
        <li>Lightning → El pago viaja por la red de canales, multi-hop.</li>
        <li>Capa de activos → En el destino, el agente convierte sats a COP.</li>
        <li>Aplicación → Strike abstrae todo lo anterior con una UI sencilla.</li>
      </ol>

      <h2>Recursos relacionados</h2>
      <ul>
        <li><a href="/que-es-bitcoin/">Qué es Bitcoin</a></li>
        <li><a href="/como-funciona-bitcoin/">Cómo funciona Bitcoin</a></li>
        <li><a href="/lightning-network/">Qué es Lightning Network</a></li>
        <li><a href="/bitvm/">Qué es BitVM</a></li>
        <li><a href="/taproot/">Qué es Taproot</a></li>
        <li><a href="/utxo/">Qué es un UTXO</a></li>
